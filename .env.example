# ============================================================
# Microsoft Rewards Script — 环境变量模板
# 复制为 .env 并填写 (chmod 600 .env)
# ============================================================

# --- 必填: 微软账号 ---
ACCOUNT_1_EMAIL=you@example.com
ACCOUNT_1_PASSWORD=your_password

# --- 推荐: TOTP 2FA secret (Authenticator 添加账户时"手动输入代码"里的 Base32 密钥) ---
# 非 6 位验证码! 是 Base32 格式的密钥字符串
ACCOUNT_1_TOTP_SECRET=

# --- 可选: PushPlus 微信通知 ---
# 获取: https://www.pushplus.plus/ → 登录 → 发送消息 → 一对一消息 → 复制 token
PUSHPLUS_ENABLED=false
PUSHPLUS_TOKEN=
PUSHPLUS_TEMPLATE=txt

# --- 可选: gmya.net appkey (解除中国热搜免费档限流) ---
# 获取: https://gmya.net/ → 注册 → 个人中心
CHINA_API_APPKEY=

# --- 可选: 多账号 (递增编号, 并同步取消 compose 注释) ---
#ACCOUNT_2_EMAIL=second@example.com
#ACCOUNT_2_PASSWORD=your_password
